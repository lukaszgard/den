// Go 1.27 stops using the macOS and Windows certificate verifiers as soon as
// SSL_CERT_FILE or SSL_CERT_DIR is set, and trusts only those files. People set
// SSL_CERT_FILE for Python tools, often to a file holding just the company root,
// which would break den's AWS calls to hosts outside TLS inspection. den trusts
// what the operating system trusts, where the company root is installed.
godebug x509sslcertoverrideplatform=0
